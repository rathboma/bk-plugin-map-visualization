{
  "name": "bk-plugin-map-visualization",
  "version": "1.0.0",
  "description": "Plot query results on an interactive map in Beekeeper Studio",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "repository": {
    "type": "git",
    "url": "https://github.com/rathboma/bk-plugin-map-visualization"
  },
  "scripts": {
    "dev": "vite",
